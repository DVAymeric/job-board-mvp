generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL : connexion utilisée par le moteur de requêtes à l'exécution
  // — en prod serverless, pointe vers le pooler (PgBouncer/Supavisor).
  // DIRECT_URL : connexion utilisée par `prisma migrate`/`db push` — les
  // migrations ont besoin d'une connexion directe, non poolée en mode
  // transaction (JOB-85). En local, les deux pointent vers le même Postgres
  // (voir .env.example) : aucun pooler n'est nécessaire en dev.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Point d'extension pour un futur palier payant (JOB-80) — un seul palier
  // existe aujourd'hui, tout lui est accessible (voir lib/plan.ts).
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs Job[]
  tags Tag[]

  campaigns         Campaign[]
  harvestedOffers   HarvestedOffer[]
  discoveredTargets DiscoveredTarget[]
}

enum Plan {
  FREE
}

enum JobStatus {
  TO_APPLY
  APPLIED
  INTERVIEW
  REJECTED
}

enum SalaryType {
  ANNUAL
  DAILY_RATE
}

// PENDING : créé sans titre, enrichissement (scraping) programmé en tâche
// de fond après la réponse de createJob (JOB-ASYNC-ENRICH). DONE : titre
// connu dès la création, ou enrichissement réussi. FAILED : enrichissement
// tenté sans succès — l'utilisateur renseigne alors le titre à la main
// (updateJobDetails repasse le statut à DONE dans ce cas).
enum EnrichmentStatus {
  PENDING
  DONE
  FAILED
}

// Type de contrat de la candidature suivie par l'utilisateur (JOB-124) —
// distinct de OfferContractType (ci-dessous), qui décrit les offres
// collectées par le Harvester et se limite à l'alternance/stage. Le Job
// personnel peut concerner n'importe quel type d'emploi.
enum JobContractType {
  CDI
  CDD
  ALTERNANCE
  STAGE
  FREELANCE
  INTERIM
  AUTRE
}

model Job {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  url              String
  title            String?
  companyName      String?
  companyLogoUrl   String?
  notes            String?
  status           JobStatus        @default(TO_APPLY)
  contractType     JobContractType?
  enrichmentStatus EnrichmentStatus @default(DONE)
  order            Int              @default(0)
  lastFollowUp     DateTime?
  salaryAmount     Int?
  salaryType       SalaryType?
  resumeUrl        String?
  coverLetterUrl   String?
  interviewDate    DateTime?
  descriptionText  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  contacts       Contact[]
  tags           JobTag[]
  statusHistory  StatusHistory[]
  harvestedOffer HarvestedOffer?

  @@unique([userId, url])
  @@unique([id, userId])
  @@index([userId])
}

model Contact {
  id          String  @id @default(uuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  role        String?
  linkedinUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([jobId])
}

model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  jobs JobTag[]

  @@unique([userId, name])
}

model JobTag {
  jobId String
  tagId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
}

model StatusHistory {
  id     String    @id @default(uuid())
  jobId  String
  job    Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status JobStatus

  changedAt DateTime @default(now())
}

enum OfferContractType {
  APPRENTISSAGE
  PROFESSIONNALISATION
  STAGE
  CDI
  CDD
  AUTRE
}

enum OfferRemotePolicy {
  ONSITE
  HYBRID
  REMOTE
  UNKNOWN
}

enum OfferLifecycle {
  ACTIVE
  EXPIRED
  DEAD_LINK
}

model Campaign {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String
  // Nom d'affichage optionnel, distinct du slug technique (identifiant stable généré depuis les
  // mots-clés à la création) — retombe sur le slug dans l'UI quand absent (porté depuis
  // job-harvester, commit 4d079b6).
  name          String?
  romeCodes     String[]
  keywords      String[]
  // Libellés de métier choisis par l'utilisateur via la recherche assistée sur le référentiel
  // ROME (ex. "Data Analyst") — affichage uniquement (CampaignRow), pas une source de vérité
  // pour le filtrage : celui-ci reste porté par romeCodes/keywords ci-dessus, déjà branchés
  // dans l'orchestrateur. Peut diverger de romeCodes/keywords si l'utilisateur les modifie
  // ensuite manuellement — acceptable, comme `name` peut diverger de `slug`.
  metiers       String[]            @default([])
  contractTypes OfferContractType[]
  schedule      String?
  // Ordre d'affichage dans l'onglet Campagnes (glisser-déposer) — même
  // convention que Job.order : défaut 0 pour toutes les campagnes existantes,
  // départagé par createdAt desc tant qu'aucun tri manuel n'a eu lieu.
  order         Int                 @default(0)
  // Configuration hétérogène par connecteur (locations, targets par source) —
  // voir le format d'origine dans job-harvester/config/campaigns.yaml. Reste
  // en Json car la forme varie par connecteur et n'est jamais filtrée en SQL.
  config        Json
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  connectorRuns   ConnectorRun[]
  harvestedOffers HarvestedOffer[]

  @@unique([userId, slug])
  @@unique([id, userId])
  @@index([userId])
}

model HarvestedOffer {
  id                    String             @id @default(uuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId            String
  campaign              Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source                String
  sourceOfferId         String
  originSource          String?
  canonicalUrl          String
  applyUrl              String?
  title                 String
  companyName           String
  companyNormalizedName String
  companySiret          String?
  companyWebsite        String?
  locationLabel         String
  city                  String
  postalCode            String?
  department            String?
  lat                   Float?
  lng                   Float?
  contractType          OfferContractType
  durationMonths        Int?
  startDate             String?
  romeCodes             String[]
  descriptionText       String
  descriptionHtml       String?
  // Objet déjà whitelisté par le schéma Zod du connecteur — jamais le
  // payload brut de l'API source (ADR-0004 job-harvester, anti-PII).
  salary                Json?
  remotePolicy          OfferRemotePolicy?
  postedAt              String?
  expiresAt             String?
  firstSeenAt           DateTime
  lastSeenAt            DateTime
  lifecycle             OfferLifecycle
  dedupKey              String
  sourceRefs            Json
  rawPayload            Json
  importedJobId         String?            @unique
  importedJob           Job?               @relation(fields: [importedJobId], references: [id])
  // Rejetée explicitement par l'utilisateur depuis la file de revue (JOB-51)
  // — distinct de importedJobId : une offre ignorée n'est pas importée, mais
  // ne doit plus réapparaître dans la file en attente.
  ignoredAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([userId, dedupKey])
  @@index([userId, campaignId])
  @@index([userId, importedJobId, ignoredAt])
}

model ConnectorRun {
  id               String   @id @default(uuid())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connectorId      String
  startedAt        DateTime
  finishedAt       DateTime
  rawCount         Int
  normalizedCount  Int
  rejectedCount    Int
  filteredCount    Int      @default(0)
  httpStatusesSeen Int[]
  ok               Boolean
  errorMessage     String?

  @@index([campaignId])
}

enum DiscoveryPlatform {
  WORKDAY
  SMARTRECRUITERS
  TALENTSOFT
  DIGITALRECRUITERS
}

enum DiscoveredTargetStatus {
  PENDING
  ADDED
  REJECTED
}

// Cache global de sondage, volontairement PAS scopé par userId : ne contient que des faits
// publics et vérifiables sur l'infrastructure de recrutement d'entreprises réelles (ex.
// "capgemini.com utilise myworkdayjobs.com"), jamais de donnée utilisateur. Partagé entre tous
// les comptes pour éviter de re-sonder en direct la même entreprise pour chacun d'eux.
model DiscoveryProbe {
  id          String            @id @default(uuid())
  companySlug String
  platform    DiscoveryPlatform
  found       Boolean
  // string (domaine) pour SmartRecruiters/Talentsoft/DigitalRecruiters, { tenant, site, dc }
  // pour Workday. Toujours null si found=false.
  target      Json?
  probedAt    DateTime          @default(now())

  @@unique([companySlug, platform])
}

// File de revue par utilisateur : une cible trouvée par le sondage global doit être approuvée
// avant de rejoindre config.targets des campagnes de CET utilisateur.
model DiscoveredTarget {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companySlug  String
  companyName  String
  platform     DiscoveryPlatform
  target       Json
  status       DiscoveredTargetStatus @default(PENDING)
  discoveredAt DateTime               @default(now())
  reviewedAt   DateTime?

  @@unique([userId, companySlug, platform])
  @@index([userId, status])
}
