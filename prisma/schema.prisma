generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL : connexion utilisée par le moteur de requêtes à l'exécution
  // — en prod serverless, pointe vers le pooler (PgBouncer/Supavisor).
  // DIRECT_URL : connexion utilisée par `prisma migrate`/`db push` — les
  // migrations ont besoin d'une connexion directe, non poolée en mode
  // transaction (JOB-85). En local, les deux pointent vers le même Postgres
  // (voir .env.example) : aucun pooler n'est nécessaire en dev.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Point d'extension pour un futur palier payant (JOB-80) — un seul palier
  // existe aujourd'hui, tout lui est accessible (voir lib/plan.ts).
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs Job[]
  tags Tag[]

  campaigns       Campaign[]
  harvestedOffers HarvestedOffer[]
}

enum Plan {
  FREE
}

enum JobStatus {
  TO_APPLY
  APPLIED
  INTERVIEW
  REJECTED
}

enum SalaryType {
  ANNUAL
  DAILY_RATE
}

// PENDING : créé sans titre, enrichissement (scraping) programmé en tâche
// de fond après la réponse de createJob (JOB-ASYNC-ENRICH). DONE : titre
// connu dès la création, ou enrichissement réussi. FAILED : enrichissement
// tenté sans succès — l'utilisateur renseigne alors le titre à la main
// (updateJobDetails repasse le statut à DONE dans ce cas).
enum EnrichmentStatus {
  PENDING
  DONE
  FAILED
}

model Job {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  url              String
  title            String?
  companyName      String?
  companyLogoUrl   String?
  notes            String?
  status           JobStatus        @default(TO_APPLY)
  enrichmentStatus EnrichmentStatus @default(DONE)
  order            Int              @default(0)
  lastFollowUp     DateTime?
  salaryAmount     Int?
  salaryType       SalaryType?
  resumeUrl        String?
  coverLetterUrl   String?
  interviewDate    DateTime?
  descriptionText  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  contacts      Contact[]
  tags          JobTag[]
  statusHistory StatusHistory[]
  harvestedOffer HarvestedOffer?

  @@unique([userId, url])
  @@unique([id, userId])
  @@index([userId])
}

model Contact {
  id          String  @id @default(uuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  role        String?
  linkedinUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([jobId])
}

model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  jobs JobTag[]

  @@unique([userId, name])
}

model JobTag {
  jobId String
  tagId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
}

model StatusHistory {
  id     String    @id @default(uuid())
  jobId  String
  job    Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status JobStatus

  changedAt DateTime @default(now())
}

enum OfferContractType {
  APPRENTISSAGE
  PROFESSIONNALISATION
  STAGE
  AUTRE
}

enum OfferRemotePolicy {
  ONSITE
  HYBRID
  REMOTE
  UNKNOWN
}

enum OfferLifecycle {
  ACTIVE
  EXPIRED
  DEAD_LINK
}

model Campaign {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String
  romeCodes     String[]
  keywords      String[]
  contractTypes OfferContractType[]
  schedule      String?
  // Configuration hétérogène par connecteur (locations, targets par source) —
  // voir le format d'origine dans job-harvester/config/campaigns.yaml. Reste
  // en Json car la forme varie par connecteur et n'est jamais filtrée en SQL.
  config        Json
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  connectorRuns   ConnectorRun[]
  harvestedOffers HarvestedOffer[]

  @@unique([userId, slug])
  @@unique([id, userId])
  @@index([userId])
}

model HarvestedOffer {
  id                    String             @id @default(uuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId            String
  campaign              Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source                String
  sourceOfferId         String
  originSource          String?
  canonicalUrl          String
  applyUrl              String?
  title                 String
  companyName           String
  companyNormalizedName String
  companySiret          String?
  companyWebsite        String?
  locationLabel         String
  city                  String
  postalCode            String?
  department            String?
  lat                   Float?
  lng                   Float?
  contractType          OfferContractType
  durationMonths        Int?
  startDate             String?
  romeCodes             String[]
  descriptionText       String
  descriptionHtml       String?
  // Objet déjà whitelisté par le schéma Zod du connecteur — jamais le
  // payload brut de l'API source (ADR-0004 job-harvester, anti-PII).
  salary                Json?
  remotePolicy          OfferRemotePolicy?
  postedAt              String?
  expiresAt             String?
  firstSeenAt           DateTime
  lastSeenAt            DateTime
  lifecycle             OfferLifecycle
  dedupKey              String
  sourceRefs            Json
  rawPayload            Json
  importedJobId         String?            @unique
  importedJob           Job?               @relation(fields: [importedJobId], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([userId, dedupKey])
  @@index([userId, campaignId])
}

model ConnectorRun {
  id               String   @id @default(uuid())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connectorId      String
  startedAt        DateTime
  finishedAt       DateTime
  rawCount         Int
  normalizedCount  Int
  rejectedCount    Int
  httpStatusesSeen Int[]
  ok               Boolean
  errorMessage     String?

  @@index([campaignId])
}
