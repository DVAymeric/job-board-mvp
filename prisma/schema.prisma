generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs Job[]
  tags Tag[]
}

enum JobStatus {
  TO_APPLY
  APPLIED
  INTERVIEW
  REJECTED
}

enum SalaryType {
  ANNUAL
  DAILY_RATE
}

model Job {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  url             String
  title           String?
  companyName     String?
  companyLogoUrl  String?
  notes           String?
  status          JobStatus   @default(TO_APPLY)
  archived        Boolean     @default(false)
  order           Int         @default(0)
  lastFollowUp    DateTime?
  salaryAmount    Int?
  salaryType      SalaryType?
  resumeUrl       String?
  coverLetterUrl  String?
  interviewDate   DateTime?
  descriptionText String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  contacts      Contact[]
  tags          JobTag[]
  statusHistory StatusHistory[]

  @@unique([userId, url])
  @@unique([id, userId])
  @@index([userId])
}

model Contact {
  id          String  @id @default(uuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  role        String?
  linkedinUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([jobId])
}

model Tag {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  jobs JobTag[]

  @@unique([userId, name])
}

model JobTag {
  jobId String
  tagId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
}

model StatusHistory {
  id     String    @id @default(uuid())
  jobId  String
  job    Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status JobStatus

  changedAt DateTime @default(now())
}
