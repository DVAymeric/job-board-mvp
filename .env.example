# Postgres local — run `docker compose up -d` then `npx prisma migrate deploy`.
# In production (serverless, JOB-85): DATABASE_URL points to the pooled
# connection (PgBouncer/Supavisor — Supabase gives one on port 6543, add
# ?pgbouncer=true&connection_limit=1), DIRECT_URL to the unpooled one (port
# 5432) that `prisma migrate` needs. Locally, both point to the same
# docker-compose Postgres — no pooler needed in dev.
#
# Production values MUST also add sslmode=require (or sslmode=verify-full,
# verify-ca, ssl=true) — lib/prisma.ts refuses to start in production
# without it (JOB-120). Managed providers (Supabase, Vercel Postgres, Neon)
# give you a connection string with this already set; don't strip it.
# Encryption at rest is a provider-side feature (enabled by default on
# Supabase/Vercel Postgres/Neon) — confirm it in the provider's dashboard
# when provisioning (JOB-82), nothing to configure here.
DATABASE_URL="postgresql://jobtracker:jobtracker@localhost:5433/jobtracker"
DIRECT_URL="postgresql://jobtracker:jobtracker@localhost:5433/jobtracker"

# Auth.js session/JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Optional — Brandfetch fallback for company logos (JOB-15). Leave unset to
# skip the fallback silently when Clearbit doesn't resolve a logo.
BRANDFETCH_CLIENT_ID=

# Optional — Sentry error monitoring (JOB-113). Leave all unset to disable
# the SDK entirely (dev/CI default) — no account required for local work.
# SENTRY_DSN: server-side (Server Actions, Server Components) errors.
# NEXT_PUBLIC_SENTRY_DSN: client-side errors (same DSN value, exposed to the
# browser — Sentry DSNs are meant to be public, they only accept writes).
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: only needed in CI/prod to
# upload source maps at build time; harmless to leave unset (skipped, not a
# build failure).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional — kill switch for the Playwright headless-browser scraper fallback
# (JOB-65), sans redéploiement si son coût/latence devient problématique en
# production. Activé par défaut ; mettre exactement "0" pour le désactiver
# (l'app retombe alors sur le seul fetch Cheerio, sans navigateur headless).
SCRAPER_PLAYWRIGHT_ENABLED=

# Never set ALLOW_LOOPBACK_FETCH_FOR_TESTS here or in Vercel env vars — it
# disables the scraper's SSRF guard against loopback/private hosts. It's
# wired only into playwright.config.ts's local Playwright-spawned dev
# server (E2E scraper fixtures, JOB-69), never read from a real deployment.

# Connecteurs de collecte (JOB-42) — tier 0, sans lesquels le connecteur
# correspondant échoue à son health check (identifiants OAuth client_credentials,
# obtenus sur https://francetravail.io après inscription à l'API "Offres
# d'emploi v2").
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Clé API La Bonne Alternance (JOB-42), obtenue sur
# https://api.apprentissage.beta.gouv.fr.
LBA_API_KEY=

# Secret partagé protégeant /api/cron/harvest (JOB-52) — Vercel l'ajoute
# automatiquement en header `Authorization: Bearer $CRON_SECRET` sur ses
# propres requêtes cron dès que cette variable est configurée sur le projet
# Vercel (Project Settings > Environment Variables). Sans elle, la route
# répond 401 à toute requête, y compris celles de Vercel Cron lui-même.
# Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
